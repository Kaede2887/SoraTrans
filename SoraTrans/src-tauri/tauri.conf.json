{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoraTrans",
  "version": "0.1.1",
  "identifier": "SoraTrans",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SoraTrans",
        "label": "main",
        "url": "launcher.html",
        "width": 800,
        "height": 520,
        "minWidth": 476,
        "minHeight": 540,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPDATA/game/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/AssetWorker"
    ],
    "resources": {
      "binaries/classdata.tpk": "",
      "binaries/e_sqlite3.dll": ""
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
